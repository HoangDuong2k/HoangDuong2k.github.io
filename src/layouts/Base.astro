---
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
}
const { title, description = 'Dương Việt Hoàng — Frontend Developer (React · TypeScript). An interactive 3D desk portfolio.' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6e7ff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
