---
import Base from '@/layouts/Base.astro'
import { education, experience, profile, projects, skills, stats } from '@/data/profile'
---

<Base title={`${profile.nameAscii} · Resume`}>
  <nav class="sticky top-0 z-10 border-b border-white/10 bg-[#0c0b14]/80 backdrop-blur-md print:hidden">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3">
      <a
        id="back-to-desk"
        href="/"
        class="inline-flex items-center gap-2 rounded-full bg-violet-500 px-4 py-2 text-sm font-medium text-white shadow-[0_0_24px_-6px] shadow-violet-500 hover:bg-violet-400"
      >
        ← Back to the 3D desk <kbd class="hidden font-mono text-xs opacity-70 sm:inline">Esc</kbd>
      </a>
      <button
        id="print-resume"
        type="button"
        class="rounded-full px-4 py-2 text-sm font-medium text-white/80 ring-1 ring-white/20 hover:bg-white/10"
      >
        Print / PDF
      </button>
    </div>
  </nav>
  <main class="mx-auto max-w-3xl px-4 py-8 sm:py-12 print:p-0">
    <div class="paper rounded-md p-7 sm:p-12 print:shadow-none">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{profile.name}</h1>
          <p class="mt-1 text-[#7C6CFF]">{profile.role} · {profile.stack} · {profile.location}</p>
          <p class="mt-2 flex flex-wrap gap-x-4 font-mono text-xs text-black/60">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <a href={profile.github}>github/{profile.handle}</a>
            <a href={profile.linkedin}>linkedin/{profile.handle}</a>
          </p>
        </div>
      </div>

      <p class="mt-6 leading-relaxed text-black/75">{profile.summary}</p>
      <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="rounded-xl bg-[#7C6CFF]/8 p-3">
            <div class="text-lg font-bold">{s.value}</div>
            <div class="text-[11px] leading-tight text-black/60">{s.label}</div>
          </div>
        ))}
      </div>

      <h2 class="mt-9 mb-3 text-xs font-bold tracking-[0.18em] text-[#7C6CFF] uppercase">Experience</h2>
      <div class="space-y-6">
        {experience.map((job) => (
          <section>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold">{job.company} <span class="font-normal text-black/55">· {job.role}</span></h3>
              <span class="font-mono text-xs text-black/50">{job.period}</span>
            </div>
            <p class="text-sm text-black/60">{job.product}</p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-black/75 marker:text-[#FF6B8B]">
              {job.points.map((p) => <li>{p}</li>)}
            </ul>
          </section>
        ))}
      </div>

      <h2 class="mt-9 mb-3 text-xs font-bold tracking-[0.18em] text-[#7C6CFF] uppercase">Projects</h2>
      <div class="space-y-4">
        {projects.map((p) => (
          <section>
            <h3 class="font-semibold" style={`color:${p.color}`}>
              {p.name} <span class="font-normal text-black/60">— {p.tagline}</span>
            </h3>
            <ul class="mt-1 list-disc space-y-1 pl-5 text-sm leading-relaxed text-black/75">
              {p.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <p class="mt-1 font-mono text-xs text-black/55">
              {p.stack.join(' · ')} · {p.demo && <a class="underline" href={p.demo}>demo</a>} <a class="underline" href={p.repo}>code</a>
            </p>
          </section>
        ))}
      </div>

      <h2 class="mt-9 mb-3 text-xs font-bold tracking-[0.18em] text-[#7C6CFF] uppercase">Skills</h2>
      <dl class="space-y-1.5 text-sm">
        {Object.entries(skills).map(([g, list]) => (
          <div class="flex flex-wrap gap-x-3">
            <dt class="w-32 font-semibold text-black/55">{g}</dt>
            <dd class="flex-1 text-black/75">{list.join(', ')}</dd>
          </div>
        ))}
      </dl>

      <h2 class="mt-9 mb-3 text-xs font-bold tracking-[0.18em] text-[#7C6CFF] uppercase">Education</h2>
      <p class="text-sm"><b>{education.school}</b> — {education.degree} <span class="font-mono text-xs text-black/50">{education.period}</span></p>
    </div>
  </main>
  <script>
    const back = document.getElementById('back-to-desk')
    // Visitors sent here because their browser has no WebGL would just bounce back.
    if (new URLSearchParams(location.search).has('nowebgl')) back?.remove()
    document.getElementById('print-resume')?.addEventListener('click', () => window.print())
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && back) location.href = '/'
    })
  </script>
</Base>
